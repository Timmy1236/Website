---
title: Blog
locale: "en"
description: Blogs and Microblogs about any topic
layout: layouts/base.html
---
{% set allTags = collections.blog_en | uniqueTags %}

<div class="card-tag-bar">
  Tags:
  {% for tag in allTags %}
  <div class="card-tag">{{ tag }}</div>
  {% endfor %}
</div>

<div class="cards-list">
  {% for post in collections.blog_en %}
  <div class="card">
    <span class="card-title">
      <a class="card-link" href="{{ post.url | url }}"> {{ post.data.title }} </a>
      <span class="card-date">{{ post.data.date | readableDate }}</span>
    </span>
    <p class="card-description">{{ post.data.description }}</p>
    <div class="card-tag-bar">
      {% for tag in post.data.tags %}
      <span class="card-tag">{{ tag }}</span>
      {% endfor %}
    </div>
  </div>
  {% endfor %}
</div>