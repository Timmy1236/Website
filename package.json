{
  "name": "timmys-dumpster",
  "version": "2.1.0",
  "description": "Una simple página web que contendrá información básica de mí y de todos los proyectos que haré en algún futuro.",
  "browserslist": [
    "defaults and fully supports es6-module or baseline widely available, not op_mini all, not kaios > 0, not ucandroid > 0, not qqandroid > 0"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "clean": "node -e \"fs.rmSync('public/dist', { recursive: true, force: true }); fs.rmSync('public/content', { recursive: true, force: true })\"",
    "build": "pnpm clean && concurrently \"pnpm:eleventy\" \"pnpm:esbuild\"",
    "dev": "pnpm clean && concurrently \"pnpm:eleventy:watch\" \"pnpm:esbuild:watch\"",
    "lint": "eslint .",
    "stylelint": "stylelint \"**/*.css\"",
    "typecheck": "tsc --noEmit",
    "eleventy": "eleventy --quiet",
    "eleventy:watch": "eleventy --quiet --watch",
    "esbuild": "node esbuild.mjs build",
    "esbuild:watch": "node esbuild.mjs watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Timmy1236/Website.git"
  },
  "keywords": [
    "website",
    "web"
  ],
  "author": "Timmy1236 (https://timmy.nekoweb.org/)",
  "licenses": [
    {
      "type": "GPL-3.0-only",
      "url": "https://github.com/Timmy1236/Website/blob/main/LICENSE"
    }
  ],
  "type": "module",
  "bugs": {
    "url": "https://github.com/Timmy1236/Website/issues"
  },
  "homepage": "https://github.com/Timmy1236/Website#readme",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/mithril": "^2.2.9",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.0",
    "eslint-plugin-compat": "^7.0.2",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "mithril": "^2.3.8"
  }
}